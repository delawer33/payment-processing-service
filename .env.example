# Copy to .env and fill in. The real .env is never committed.

# --- API ---
API_PORT_INTERNAL=8000
API_PORT_EXTERNAL=8000
ENVIRONMENT=local
LOG_LEVEL=INFO
# Static key every client sends in X-API-Key. Generate a real one for any shared environment.
API_KEY=change-me
# Key used to sign outgoing webhooks (X-Signature: sha256=<hmac>). Generate a real one outside local runs.
WEBHOOK_SECRET=change-me

# --- Postgres ---
POSTGRES_USER=payment_processing
POSTGRES_PASSWORD=payment_processing
POSTGRES_DB=payment_processing
POSTGRES_PORT_INTERNAL=5432
POSTGRES_PORT_EXTERNAL=5432
# Local run outside compose; inside compose the host becomes `db` (set in docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://payment_processing:payment_processing@localhost:5432/payment_processing

# --- RabbitMQ ---
RABBITMQ_USER=payment_processing
RABBITMQ_PASSWORD=payment_processing
RABBITMQ_PORT_INTERNAL=5672
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_MANAGEMENT_PORT_EXTERNAL=15672
# Local run outside compose; inside compose the host becomes `rabbitmq` (set in docker-compose.yml).
RABBITMQ_URL=amqp://payment_processing:payment_processing@localhost:5672/
