# Значения только для локального kind. Пароли повторяются в URL: Kubernetes не собирает
# строку из нескольких ключей Secret.
API_KEY=change-me
WEBHOOK_SECRET=change-me
POSTGRES_USER=payment_processing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payment_processing
RABBITMQ_DEFAULT_USER=payment_processing
RABBITMQ_DEFAULT_PASS=change-me
DATABASE_URL=postgresql+asyncpg://payment_processing:change-me@postgres:5432/payment_processing
RABBITMQ_URL=amqp://payment_processing:change-me@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
